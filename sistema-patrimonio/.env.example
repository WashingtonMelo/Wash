# Chave secreta para Flask (mude para um valor aleatório e seguro)
SECRET_KEY='coloque_sua_chave_secreta_aqui'

# Configurações do Firebase - Cliente Web (geralmente para frontend)
# Estas são obtidas no console do Firebase: Configurações do projeto > Geral > Seus apps > Configuração do SDK
FIREBASE_API_KEY='SUA_FIREBASE_API_KEY'
FIREBASE_AUTH_DOMAIN='SEU_PROJETO_ID.firebaseapp.com'
FIREBASE_PROJECT_ID='SEU_PROJETO_ID'
FIREBASE_STORAGE_BUCKET='SEU_PROJETO_ID.appspot.com'
FIREBASE_MESSAGING_SENDER_ID='SEU_SENDER_ID'
FIREBASE_APP_ID='SEU_APP_ID'
FIREBASE_MEASUREMENT_ID='SEU_MEASUREMENT_ID' # Opcional, para Analytics
FIREBASE_DATABASE_URL_CLIENT='https://SEU_PROJETO_ID-default-rtdb.firebaseio.com' # Se usar Realtime Database no cliente

# Configurações do Firebase Admin SDK (para backend)
# Baixe o arquivo JSON da chave de serviço do console do Firebase:
# Configurações do projeto > Contas de serviço > Gerar nova chave privada
# Salve este arquivo em um local seguro (NÃO o adicione ao Git) e coloque o caminho aqui.
# Exemplo para desenvolvimento local (NÃO RECOMENDADO PARA PRODUÇÃO DIRETAMENTE NO CÓDIGO):
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH='caminho/para/seu/serviceAccountKey.json'
# É MELHOR definir esta variável no seu ambiente (ex: no .bashrc, .zshrc, ou variáveis de ambiente do sistema/hosting)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=''

# URL do Banco de Dados Firebase (para Admin SDK, se usar Realtime Database)
# Geralmente não é necessário para Firestore se as credenciais estiverem corretas.
FIREBASE_DATABASE_URL='https://SEU_PROJETO_ID-default-rtdb.firebaseio.com'

# Configurações de Email (exemplo para Gmail, ajuste conforme seu provedor)
# MAIL_SERVER='smtp.googlemail.com'
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME='seu_email@gmail.com'
# MAIL_PASSWORD='sua_senha_de_app_do_email' # Use senha de app se tiver 2FA

# Porta para rodar a aplicação Flask localmente
# PORT=5000
